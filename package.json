{
  "name": "whattowatch-co-il",
  "private": true,
  "type": "module",
  "description": "WhatToWatch.co.il — Hebrew-first streaming recommendation platform",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "node scripts/generateHostFiles.mjs && npm run generate:sitemap && npm run generate:rss && npm run generate:llms && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fetch:netflix": "node scripts/fetchTopSeries.mjs",
    "fetch:genres": "node scripts/fetchGenreShowcases.mjs",
    "backfill:months": "node scripts/backfillMonths.mjs",
    "generate:sitemap": "node scripts/generateSitemap.mjs",
    "generate:rss": "node scripts/generateRSS.mjs",
    "generate:llms": "node scripts/generateLlmsTxt.mjs",
    "monthly:update": "npm run fetch:netflix && npm run fetch:genres && npm run generate:sitemap && npm run generate:rss && npm run generate:llms",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/content": "^3.0.0",
    "@nuxt/image": "^1.8.1",
    "@nuxtjs/i18n": "^9.1.1",
    "@pinia/nuxt": "^0.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/nuxt": "^12.4.0",
    "nuxt": "^4.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@types/node": "^22.10.5",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.12",
    "yaml": "^2.7.0"
  }
