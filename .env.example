# TMDB — נדרש לשליפת סדרות אמיתיות. בלעדיו, scripts/fetchTopSeries.mjs
# ייצור תוכן פייק ריאליסטי כדי ש-npm run dev / generate יעבדו תמיד.
# קבל Read Access Token ב: https://www.themoviedb.org/settings/api
# (לשונית "API Read Access Token" — ה-JWT הארוך שמתחיל ב-eyJ...)
TMDB_READ_ACCESS_TOKEN=
# חלופה (v3 API key קצר): TMDB_API_KEY=

# אופציונלי — "ביקורת הבינג'יונרים" של כל סדרה. בלעדיו, ביקורת העורך
# חוזרת לתבניות כלליות (buildTemplateEditorReview) בלי לשבור כלום.
# איתו, הסקריפט שולף ביקורת אמיתית מ-TMDB ומסכם אותה בעברית, בקול
# האתר, באמצעות Gemini (tier חינמי לגמרי, בלי כרטיס אשראי). קבל מפתח
# חינמי ב-https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# חלופה למודל (ברירת מחדל: alias "latest" כדי לא להתיישן כשגוגל
# מוציא מודלים חדשים — קבע גרסה מפורשת אם את/ה רוצה שליטה יותר קפדנית):
# GEMINI_MODEL=gemini-flash-lite-latest

# כתובת האתר בפרודקשן — לצורך canonical/sitemap/OG
NUXT_PUBLIC_SITE_URL=https://whattowatch.co.il

# Google AdSense. כש-ENABLED=true ויש ca-pub-..., נטען Auto ads ונוצר ads.txt
# בזמן generate. בלי מזהה — לא נטען סקריפט ואין תיבת placeholder.
# יחידות ידניות (מספריות מלוח AdSense) אופציונליות; בליהן Auto ads בלבד.
NUXT_PUBLIC_ADSENSE_ENABLED=false
NUXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# NUXT_PUBLIC_ADSENSE_SLOT_HOME=
# NUXT_PUBLIC_ADSENSE_SLOT_PROVIDER=
# NUXT_PUBLIC_ADSENSE_SLOT_MONTHLY=

# Affiliate — קישורים לעולם לא hardcoded בקוד, רק כאן.
NUXT_PUBLIC_AFFILIATE_NORDVPN_ID=
NUXT_PUBLIC_AFFILIATE_AMAZON_TAG=

# Vercel deployment (לשימוש ב-GitHub Actions secrets, לא כאן מקומית)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
