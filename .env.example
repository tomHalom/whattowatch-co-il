# TMDB — נדרש לשליפת סדרות אמיתיות. בלעדיו, scripts/fetchTopSeries.mjs
# ייצור תוכן פייק ריאליסטי כדי ש-npm run dev / generate יעבדו תמיד.
# קבל מפתח חינמי ב-https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# כתובת האתר בפרודקשן — לצורך canonical/sitemap/OG
NUXT_PUBLIC_SITE_URL=https://whattowatch.co.il

# Google AdSense — נדרש חשבון מאושר. עד לאישור, השאר ADSENSE_ENABLED=false
# כדי שקומפוננטת AdSlot תרנדר placeholder שקט ולא תנסה לטעון סקריפט חסר.
NUXT_PUBLIC_ADSENSE_ENABLED=false
NUXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Affiliate — קישורים לעולם לא hardcoded בקוד, רק כאן.
NUXT_PUBLIC_AFFILIATE_NORDVPN_ID=
NUXT_PUBLIC_AFFILIATE_AMAZON_TAG=

# Vercel deployment (לשימוש ב-GitHub Actions secrets, לא כאן מקומית)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
